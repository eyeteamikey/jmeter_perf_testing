<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2">
  <hashTree>
    <!-- Test Plan -->
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Spike and Recovery Test Plan" enabled="true">
      <stringProp name="TestPlan.comments"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <!-- Base URL parameterized -->
        <collectionProp name="Arguments.arguments">
          <elementProp name="base_url" elementType="Argument">
            <stringProp name="Argument.name">base_url</stringProp>
            <stringProp name="Argument.value">${__P(base_url)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.serialize_threadgroups">false</stringProp>
    </TestPlan>
    <hashTree>
      <!-- Concurrency Thread Group -->
      <kg.apc.jmeter.threads.ConcurrencyThreadGroup guiclass="ConcurrencyThreadGroupGui"
        testclass="kg.apc.jmeter.threads.ConcurrencyThreadGroup"
        testname="Spike Recovery Thread Group" enabled="true">
        <!-- Load profile: 0→5 over 30s, 5→100 over 60s, stay 60s, 100→5 over 30s, stay 60s -->
        <collectionProp name="kg.apc.concurrency.ThreadGroup.profile">
          <stringProp name="1">0 5 30</stringProp>
          <stringProp name="2">5 100 60</stringProp>
          <stringProp name="3">100 100 60</stringProp>
          <stringProp name="4">100 5 30</stringProp>
          <stringProp name="5">5 5 60</stringProp>
        </collectionProp>
        <stringProp name="kg.apc.concurrency.ThreadGroup.duration">300</stringProp>
        <stringProp name="kg.apc.concurrency.ThreadGroup.units">seconds</stringProp>
        <stringProp name="kg.apc.concurrency.ThreadGroup.delay">0</stringProp>
      </kg.apc.jmeter.threads.ConcurrencyThreadGroup>
      <hashTree>
        <!-- HTTP Request Defaults for base URL -->
        <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement"
            testname="HTTP Request Defaults" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments" />
          </elementProp>
          <stringProp name="HTTPSampler.domain">${base_url}</stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.path"></stringProp>
          <stringProp name="HTTPSampler.follow_redirects">true</stringProp>
          <stringProp name="HTTPSampler.auto_redirects">false</stringProp>
          <stringProp name="HTTPSampler.use_keepalive">true</stringProp>
        </ConfigTestElement>
        <hashTree/>

        <!-- The actual load: GET /activities -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
            testname="GET /Activities" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments" />
          </elementProp>
          <stringProp name="HTTPSampler.domain">${base_url}</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/Activities</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.use_keepalive">true</stringProp>
          <elementProp name="HeaderManager.headers" elementType="HeaderManager">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="Content-Type" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>

        <!-- Assertions to ensure <500ms, status 200 -->
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK" enabled="true">
          <collectionProp name="Asserion.test_strings">
            <stringProp name="200">200</stringProp>
          </collectionProp>
          <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.logic">0</intProp>
        </ResponseAssertion>
        <hashTree/>
        <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
           testname="Assert <500 ms" enabled="true">
          <stringProp name="DurationAssertion.duration">500</stringProp>
        </DurationAssertion>
        <hashTree/>

        <!-- View Results Tree (debug only) -->
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector"
            testname="View Results Tree" enabled="false">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
        </ResultCollector>
        <hashTree/>

        <!-- Backend Listener to InfluxDB (only if monitoring) -->
        <BackendListener guiclass="BackendListenerGui" testclass="BackendListener"
            testname="Write to InfluxDB" enabled="true">
          <elementProp name="arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <!-- configure according to your env_config -->
            </collectionProp>
          </elementProp>
          <stringProp name="classname">org.apache.jmeter.visualizers.backend.influxdb.InfluxdbBackendListenerClient</stringProp>
        </BackendListener>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
